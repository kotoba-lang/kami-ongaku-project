{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        io.github.kotoba-lang/kami-ongaku-notation
        {:git/url "https://github.com/kotoba-lang/kami-ongaku-notation"
         :git/sha "604b857e9d4ee97be6178a02f2573c69154de7af"}
        io.github.kotoba-lang/kami-ongaku-sequencer
